# MOCK Авторизация (включение: true, выключение: false)
MOCK_AUTH_ENABLED=true
# Роль по умолчанию (Admin, Lpr, Hod, Teacher, Rod, DepartmentResponsible, Student, Guest)
MOCK_AUTH_DEFAULT_ROLE=Admin
# Имя HTTP-заголовка для передачи роли
MOCK_AUTH_HEADER_NAME=X-Mock-Role
