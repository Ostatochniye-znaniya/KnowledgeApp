@baseUrl = http://localhost:5134/csh/api

### Get current teacher's assigned testings
GET {{baseUrl}}/TeacherWorkflow/GetTestings

### Set testing delivery format and save the room for testing 1
PUT {{baseUrl}}/TeacherWorkflow/UpdateTestingDelivery/1/delivery
Content-Type: application/json

{
  "isInPerson": true,
  "room": "Аудитория 401",
  "lmsUrl": null
}

### Set LMS delivery format and save its URL for testing 1
PUT {{baseUrl}}/TeacherWorkflow/UpdateTestingDelivery/1/delivery
Content-Type: application/json

{
  "isInPerson": false,
  "room": null,
  "lmsUrl": "https://lms.mospolytech.ru/course/123"
}

### Approve testing 1
POST {{baseUrl}}/TeacherWorkflow/ApproveTesting/1/approve

### Reject testing 1
POST {{baseUrl}}/TeacherWorkflow/RejectTesting/1/reject
Content-Type: application/json

{
  "comment": "Не подходит назначенное время"
}

### Choose a date and time within the assigned testing period
PUT {{baseUrl}}/TeacherWorkflow/ChooseTestingTime/1/choose-time
Content-Type: application/json

{
  "date": "2026-11-02",
  "pairNumber": 1
}

### Change the selected date and pair within the assigned testing period
PUT {{baseUrl}}/TeacherWorkflow/UpdateTestingTime/1/change-time
Content-Type: application/json

{
  "date": "2026-11-03",
  "pairNumber": 2
}

### Get unread teacher workflow notifications
GET {{baseUrl}}/TeacherWorkflow/GetNotifications?unreadOnly=true

### Mark notification 1 as read
PUT {{baseUrl}}/TeacherWorkflow/MarkNotificationRead/1/read

### Get current teacher's report tasks
GET {{baseUrl}}/TeacherWorkflow/GetReports

### Download a DOCX report template
GET {{baseUrl}}/TeacherWorkflow/GenerateReport?groupId=1&semesterId=1&disciplineId=1

### Download a blank DOCX report template
GET {{baseUrl}}/TeacherWorkflow/GenerateBlankReportTemplate

### Upload a completed DOCX report
POST {{baseUrl}}/TeacherWorkflow/UploadReport/1/upload
Content-Type: multipart/form-data; boundary=----teacher-report-form

------teacher-report-form
Content-Disposition: form-data; name="File"; filename="report.docx"
Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document

< ./report.docx
------teacher-report-form--
