@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Согласование тестирований";
}

<header class="page-heading">
    <div>
        <h1>Согласование тестирований</h1>
        <p>Проверьте назначенные дату и время. Выберите очный формат и укажите аудиторию или оставьте дистанционный формат и при необходимости добавьте ссылку LMS.</p>
    </div>
</header>

<section class="surface-card" aria-label="Назначенные тестирования">
    <div class="toolbar">
        <div class="toolbar-left">
            <input class="search" id="search" type="search" placeholder="Поиск по группе или дисциплине" aria-label="Поиск по группе или дисциплине">
        </div>
        <div class="toolbar-right">
            <select class="select" id="status-filter" aria-label="Фильтр по статусу">
                <option value="">Все статусы</option>
                <option value="pending">Ожидают ответа</option>
                <option value="approved">Согласованы</option>
                <option value="rejected">Отклонены</option>
            </select>
            <span class="badge badge-accent" id="row-count">Загрузка…</span>
        </div>
    </div>
    <p id="message" class="notice" role="status">Загружаем назначения…</p>
    <div class="table-scroll">
        <table class="app-table approval-table">
            <thead>
                <tr>
                    <th>Группа</th>
                    <th>Дисциплина</th>
                    <th>Дата и время</th>
                    <th>Очно</th>
                    <th>Аудитория / LMS</th>
                    <th class="table-status">Статус</th>
                    <th class="table-actions">Действие</th>
                </tr>
            </thead>
            <tbody id="rows"></tbody>
        </table>
    </div>
</section>
<p class="footer-note">Изменения формата, аудитории и ссылки LMS сохраняются сразу и отображаются ответственному подразделению. Согласование даты и времени при этом не сбрасывается.</p>

<div class="modal-backdrop" id="reject-modal" hidden>
    <section class="modal" role="dialog" aria-modal="true" aria-labelledby="reject-modal-title">
        <h2 id="reject-modal-title">Отклонить назначенное время</h2>
        <p>Укажите причину отказа. Её увидит ответственное подразделение.</p>
        <textarea id="reject-comment" maxlength="1000" placeholder="Причина отказа" required></textarea>
        <div class="modal-actions">
            <button class="button" type="button" id="cancel-reject">Отмена</button>
            <button class="button button-danger" type="button" id="confirm-reject">Отклонить</button>
        </div>
    </section>
</div>

<div class="modal-backdrop" id="delivery-modal" hidden>
    <section class="modal" role="dialog" aria-modal="true" aria-labelledby="delivery-modal-title">
        <h2 id="delivery-modal-title">Ссылка LMS</h2>
        <p>Добавьте или измените ссылку на тестирование. Чтобы удалить ссылку, очистите поле и сохраните.</p>
        <label class="delivery-field-label" for="delivery-lms-url">Ссылка на тестирование в LMS</label>
        <input id="delivery-lms-url" type="url" maxlength="2048" placeholder="https://…" autocomplete="url">
        <div class="modal-actions">
            <button class="button" type="button" id="cancel-delivery">Отмена</button>
            <button class="button button-primary" type="button" id="save-delivery">Сохранить ссылку</button>
        </div>
    </section>
</div>

@section Scripts {
<script>
    const listUrl = '@Url.Action("GetTestings", "TeacherWorkflow")';
    const apiBaseUrl = listUrl.replace(/\/GetTestings$/, '');
    const rows = document.getElementById('rows');
    const message = document.getElementById('message');
    const count = document.getElementById('row-count');
    const rejectModal = document.getElementById('reject-modal');
    const rejectComment = document.getElementById('reject-comment');
    const confirmReject = document.getElementById('confirm-reject');
    const deliveryModal = document.getElementById('delivery-modal');
    const deliveryLmsUrlInput = document.getElementById('delivery-lms-url');
    const saveDeliveryButton = document.getElementById('save-delivery');
    let items = [];
    let rejectTestingId = null;
    let deliveryTestingId = null;

    const statusLabels = {
        pending: 'Ожидает ответа',
        approved: 'Согласовано',
        rejected: 'Нужно переназначить'
    };

    function makeCell(row, className) {
        const cell = row.insertCell();
        if (className) cell.className = className;
        return cell;
    }

    function addBadge(cell, label, kind) {
        const badge = document.createElement('span');
        badge.className = `badge ${kind || ''}`;
        badge.textContent = label;
        cell.append(badge);
    }

    function render() {
        rows.replaceChildren();
        const query = document.getElementById('search').value.trim().toLocaleLowerCase('ru');
        const statusFilter = document.getElementById('status-filter').value;
        const visibleItems = items.filter(item => {
            const matchesText = `${item.groupName} ${item.disciplineName}`.toLocaleLowerCase('ru').includes(query);
            return matchesText && (!statusFilter || item.approvalStatus === statusFilter);
        });
        count.textContent = `${visibleItems.length} из ${items.length}`;
        if (!visibleItems.length) {
            message.hidden = false;
            message.className = 'notice';
            message.innerHTML = '<strong>Ничего не найдено</strong>Измените фильтр или проверьте назначения.';
            return;
        }
        message.hidden = true;

        for (const item of visibleItems) {
            const row = rows.insertRow();
            const group = makeCell(row);
            const groupText = document.createElement('span');
            groupText.className = 'primary-text';
            groupText.textContent = item.groupName || '—';
            group.append(groupText);

            const discipline = makeCell(row);
            discipline.textContent = item.disciplineName || '—';

            const schedule = makeCell(row);
            const dateTime = document.createElement('div');
            dateTime.className = 'primary-text';
            dateTime.textContent = item.scheduledDate && item.scheduledTime
                ? `${item.scheduledDate} · ${String(item.scheduledTime).slice(0, 5)}`
                : 'Расписание не назначено';
            schedule.append(dateTime);
            if (item.respondedAt) {
                const responded = document.createElement('div');
                responded.className = 'secondary-text';
                responded.textContent = `Ответ: ${new Date(item.respondedAt).toLocaleDateString('ru-RU')}`;
                schedule.append(responded);
            }

            const modeCell = makeCell(row);
            const modeToggle = document.createElement('label');
            modeToggle.className = 'delivery-toggle';
            const inPersonCheckbox = document.createElement('input');
            inPersonCheckbox.type = 'checkbox';
            inPersonCheckbox.checked = item.isInPerson === true;
            inPersonCheckbox.setAttribute('aria-label', `Проводить очно: ${item.groupName}, ${item.disciplineName}`);
            inPersonCheckbox.addEventListener('change', async () => {
                inPersonCheckbox.disabled = true;
                const saved = await saveDelivery(item, {
                    isInPerson: inPersonCheckbox.checked,
                    room: item.room || '',
                    lmsUrl: item.lmsUrl || ''
                });
                if (saved) {
                    showSuccess(inPersonCheckbox.checked
                        ? 'Выбран очный формат. Укажите аудиторию.'
                        : 'Выбран дистанционный формат.');
                }
            });
            modeToggle.append(inPersonCheckbox, document.createTextNode('Очно'));
            modeCell.append(modeToggle);

            const place = makeCell(row);
            if (item.isInPerson === true) {
                const roomEditor = document.createElement('div');
                roomEditor.className = 'room-editor';
                const roomInput = document.createElement('input');
                roomInput.className = 'room-input';
                roomInput.type = 'text';
                roomInput.maxLength = 255;
                roomInput.placeholder = 'Аудитория';
                roomInput.value = item.room || '';
                roomInput.setAttribute('aria-label', `Аудитория: ${item.groupName}, ${item.disciplineName}`);
                const saveRoom = document.createElement('button');
                saveRoom.type = 'button';
                saveRoom.className = 'icon-button';
                saveRoom.textContent = '✓';
                saveRoom.title = 'Сохранить аудиторию';
                saveRoom.setAttribute('aria-label', `Сохранить аудиторию: ${item.groupName}, ${item.disciplineName}`);
                const updateRoomButton = () => {
                    saveRoom.disabled = roomInput.value.trim() === (item.room || '');
                };
                roomInput.addEventListener('input', updateRoomButton);
                saveRoom.addEventListener('click', async () => {
                    saveRoom.disabled = true;
                    const saved = await saveDelivery(item, {
                        isInPerson: true,
                        room: roomInput.value.trim(),
                        lmsUrl: item.lmsUrl || ''
                    });
                    if (saved) showSuccess('Аудитория сохранена и отображается ответственному подразделению.');
                });
                updateRoomButton();
                roomEditor.append(roomInput, saveRoom);
                place.append(roomEditor);
            } else {
                const lmsControls = document.createElement('div');
                lmsControls.className = 'lms-editor';
                const hasLmsLink = isHttpUrl(item.lmsUrl);
                const link = document.createElement(hasLmsLink ? 'a' : 'button');
                link.textContent = 'LMS';
                if (hasLmsLink) {
                    link.className = 'lms-link';
                    link.href = item.lmsUrl;
                    link.target = '_blank';
                    link.rel = 'noopener noreferrer';
                    link.title = item.lmsUrl;
                } else {
                    link.type = 'button';
                    link.className = 'button button-subtle';
                    link.title = 'Добавить ссылку LMS';
                    link.addEventListener('click', () => openDelivery(item.testingId));
                }
                const editLms = document.createElement('button');
                editLms.type = 'button';
                editLms.className = 'icon-button';
                editLms.textContent = '✎';
                editLms.title = hasLmsLink ? 'Изменить ссылку LMS' : 'Добавить ссылку LMS';
                editLms.setAttribute('aria-label', `${hasLmsLink ? 'Изменить' : 'Добавить'} ссылку LMS: ${item.groupName}, ${item.disciplineName}`);
                editLms.addEventListener('click', () => openDelivery(item.testingId));
                lmsControls.append(link, editLms);
                place.append(lmsControls);
            }

            const status = item.scheduledDate && item.scheduledTime
                ? (statusLabels[item.approvalStatus] || item.approvalStatus)
                : 'Ожидает расписания';
            addBadge(makeCell(row, 'table-status'), status,
                item.scheduledDate && item.scheduledTime && item.approvalStatus === 'approved' ? 'badge-success'
                    : item.scheduledDate && item.scheduledTime && item.approvalStatus === 'rejected' ? 'badge-danger'
                    : item.scheduledDate && item.scheduledTime ? 'badge-warning' : '');

            const actionsCell = makeCell(row, 'table-actions');
            const actions = document.createElement('div');
            actions.className = 'row-actions';
            actionsCell.append(actions);
            if (!item.scheduledDate || !item.scheduledTime) {
                const note = document.createElement('span');
                note.className = 'secondary-text';
                note.textContent = 'Ожидает назначения времени';
                actions.append(note);
            } else if (item.comment) {
                const comment = document.createElement('div');
                comment.className = 'secondary-text';
                comment.textContent = `Причина: ${item.comment}`;
                actions.append(comment);
            }
            if (item.approvalStatus === 'pending' && item.scheduledDate && item.scheduledTime) {
                const approve = document.createElement('button');
                approve.type = 'button';
                approve.className = 'button button-primary';
                approve.textContent = 'Согласовать';
                approve.onclick = () => decide(item.testingId, 'approve');

                const reject = document.createElement('button');
                reject.type = 'button';
                reject.className = 'button button-danger';
                reject.textContent = 'Отклонить';
                reject.onclick = () => openReject(item.testingId);
                actions.append(approve, reject);
            } else if (item.scheduledDate && item.scheduledTime && !item.comment) {
                const note = document.createElement('span');
                note.className = 'secondary-text';
                note.textContent = item.approvalStatus === 'approved' ? 'Ответ отправлен' : 'Действий нет';
                actions.append(note);
            }
        }
    }

    function showError(text) {
        message.hidden = false;
        message.className = 'notice error feedback';
        message.textContent = text;
    }

    function showSuccess(text) {
        message.hidden = false;
        message.className = 'notice success feedback';
        message.textContent = text;
    }

    function isHttpUrl(value) {
        if (!value) return false;
        try {
            const url = new URL(value);
            return url.protocol === 'http:' || url.protocol === 'https:';
        } catch {
            return false;
        }
    }

    async function saveDelivery(item, delivery) {
        try {
            const response = await fetch(`${apiBaseUrl}/UpdateTestingDelivery/${item.testingId}/delivery`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(delivery)
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) {
                throw new Error(result.error || `Не удалось сохранить формат тестирования (${response.status})`);
            }
            Object.assign(item, result);
            render();
            return true;
        } catch (error) {
            render();
            showError(error.message || 'Не удалось сохранить формат тестирования.');
            return false;
        }
    }

    function openDelivery(testingId) {
        const item = items.find(testing => testing.testingId === testingId);
        if (!item) return;
        deliveryTestingId = testingId;
        deliveryLmsUrlInput.value = item.lmsUrl || '';
        deliveryModal.hidden = false;
        deliveryLmsUrlInput.focus();
    }

    function closeDelivery() {
        deliveryModal.hidden = true;
        deliveryTestingId = null;
    }

    async function decide(id, action, body) {
        try {
            const response = await fetch(`${apiBaseUrl}/${action === 'approve' ? 'ApproveTesting' : 'RejectTesting'}/${id}/${action}`, {
                method: 'POST',
                headers: body ? { 'Content-Type': 'application/json' } : {},
                body: body ? JSON.stringify(body) : undefined
            });
            if (!response.ok) {
                const payload = await response.json().catch(() => ({}));
                throw new Error(payload.error || `Не удалось сохранить решение (${response.status})`);
            }
            await load();
            return true;
        } catch (error) {
            showError(error.message || 'Не удалось сохранить решение.');
            return false;
        }
    }

    function openReject(testingId) {
        rejectTestingId = testingId;
        rejectComment.value = '';
        rejectComment.setCustomValidity('');
        rejectModal.hidden = false;
        rejectComment.focus();
    }

    function closeReject() {
        rejectModal.hidden = true;
        rejectComment.value = '';
        rejectComment.setCustomValidity('');
        rejectTestingId = null;
    }

    async function load() {
        message.hidden = false;
        message.className = 'notice';
        message.textContent = 'Загружаем назначения…';
        try {
            const response = await fetch(listUrl);
            if (!response.ok) {
                const payload = await response.json().catch(() => ({}));
                throw new Error(payload.error || `Ошибка загрузки (${response.status})`);
            }
            items = await response.json();
            if (!items.length) {
                rows.replaceChildren();
                count.textContent = '0 назначений';
                message.hidden = false;
                message.innerHTML = '<strong>Назначений пока нет</strong>Когда вам назначат тестирование, оно появится здесь.';
                return;
            }
            render();
        } catch (error) {
            count.textContent = 'Ошибка';
            showError(error.message || 'Не удалось загрузить назначения.');
        }
    }

    document.getElementById('search').addEventListener('input', render);
    document.getElementById('status-filter').addEventListener('change', render);
    document.getElementById('cancel-reject').addEventListener('click', closeReject);
    document.getElementById('cancel-delivery').addEventListener('click', closeDelivery);
    deliveryLmsUrlInput.addEventListener('input', () => {
        deliveryLmsUrlInput.setCustomValidity('');
    });
    saveDeliveryButton.addEventListener('click', async () => {
        if (deliveryTestingId === null) return;
        const item = items.find(testing => testing.testingId === deliveryTestingId);
        if (!item) return;
        const url = deliveryLmsUrlInput.value.trim();
        if (url && !isHttpUrl(url)) {
            deliveryLmsUrlInput.setCustomValidity('Введите полный адрес с протоколом http:// или https://.');
            deliveryLmsUrlInput.reportValidity();
            return;
        }
        deliveryLmsUrlInput.setCustomValidity('');
        saveDeliveryButton.disabled = true;
        const previousLmsUrl = item.lmsUrl || '';
        const delivery = {
            isInPerson: item.isInPerson === true,
            room: item.room || '',
            lmsUrl: url
        };
        try {
            const saved = await saveDelivery(item, delivery);
            if (saved) {
                closeDelivery();
                showSuccess(previousLmsUrl && !delivery.lmsUrl
                        ? 'Ссылка LMS удалена.'
                        : 'Ссылка LMS сохранена и отображается ответственному подразделению.');
            }
        } finally {
            saveDeliveryButton.disabled = false;
        }
    });
    deliveryModal.addEventListener('click', event => {
        if (event.target === deliveryModal) closeDelivery();
    });
    rejectComment.addEventListener('input', () => rejectComment.setCustomValidity(''));
    confirmReject.addEventListener('click', async () => {
        const comment = rejectComment.value.trim();
        if (!comment) {
            rejectComment.setCustomValidity('Укажите причину отказа.');
            rejectComment.reportValidity();
            return;
        }
        if (rejectTestingId === null) return;

        confirmReject.disabled = true;
        try {
            const saved = await decide(rejectTestingId, 'reject', { comment });
            if (saved) closeReject();
        } finally {
            confirmReject.disabled = false;
        }
    });
    rejectModal.addEventListener('click', event => {
        if (event.target === rejectModal) closeReject();
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
            if (!rejectModal.hidden) closeReject();
            if (!deliveryModal.hidden) closeDelivery();
        }
    });
    load();
</script>
}
