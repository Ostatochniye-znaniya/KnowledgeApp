@model KnowledgeApp.API.Models.SignatoriesByDepartmentViewModel

@{
    Layout = null;
    ViewData["Title"] = "Подписанты по подразделениям";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --app-bg: linear-gradient(135deg, #D3D8FA 0%, #F9F9F9 100%);
            --card-bg: #FFFFFF;
            --surface-soft: #EDEDED;
            --surface-alt: #F5F6FE;
            --border: #DBDBDB;
            --divider: #EDEDF9;
            --text: #272727;
            --text-muted: #A3A3A3;
            --icon: #525252;
            --link: #6084E4;
            --link-hover: #5B73BF;
            --primary: #5F6DEC;
            --primary-dark: #4B5EDB;
            --primary-soft: rgba(95, 109, 236, 0.08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 24px;
            background: var(--app-bg);
            color: var(--text);
            font-family: 'Montserrat', 'Segoe UI', sans-serif;
        }

        .page {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.42);
            border: 1px solid var(--border);
            border-radius: 22px;
            box-shadow: 0 18px 40px rgba(95, 109, 236, 0.08);
            overflow: hidden;
            backdrop-filter: blur(8px);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 0;
            padding: 20px 30px;
            background: linear-gradient(135deg, #5F6DEC 0%, #4B5EDB 100%);
            color: #ffffff;
        }

        h1 {
            margin: 0 0 6px;
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.01em;
        }

        .subtitle {
            margin: 0;
            color: rgba(255, 255, 255, 0.88);
            font-size: 14px;
            font-weight: 500;
        }

        .back-link {
            flex: 0 0 auto;
            padding: 10px 16px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.6);
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 2px 8px rgba(95, 109, 236, 0.15);
            transition: all 0.2s ease;
        }

        .back-link:hover {
            background: #ffffff;
            color: var(--primary);
        }

        .summary {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            padding: 20px 30px 0;
        }

        .summary-item {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 48px;
            padding: 10px 18px;
            border-radius: 10px;
            background: var(--surface-soft);
            border: 1px solid var(--border);
            box-shadow: 0 2px 8px rgba(39, 39, 39, 0.04);
            color: var(--text);
            font-size: 14px;
            font-weight: 500;
            line-height: 1.4;
        }

        .summary-item strong {
            color: var(--primary);
            font-size: 18px;
            font-weight: 800;
            line-height: 1;
        }

        .chart {
            display: grid;
            gap: 14px;
            padding: 20px 30px 30px;
        }

        .department {
            display: grid;
            grid-template-columns: minmax(220px, .9fr) 64px minmax(280px, 1.4fr);
            align-items: stretch;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--card-bg);
            box-shadow: 0 3px 12px rgba(95, 109, 236, 0.06);
        }

        .department h2 {
            display: flex;
            align-items: center;
            margin: 0;
            padding: 16px 18px;
            border-right: 1px solid var(--divider);
            background: rgba(245, 246, 254, 0.8);
            font-size: 20px;
            line-height: 1.4;
            overflow-wrap: anywhere;
            color: var(--text);
            font-weight: 700;
        }

        .connection {
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--link);
            font-size: 28px;
            background: var(--surface-alt);
        }

        .signatory-list {
            display: grid;
            align-content: center;
            gap: 10px;
            padding: 14px;
        }

        .signatory {
            padding: 12px 14px;
            border-left: 4px solid var(--primary);
            border-radius: 6px;
            background: rgba(95, 109, 236, 0.06);
        }

        .signatory-name {
            font-weight: 700;
            overflow-wrap: anywhere;
            color: var(--text);
            font-size: 14px;
        }

        .job-name {
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 13px;
            overflow-wrap: anywhere;
            font-weight: 500;
        }

        .empty {
            padding: 28px;
            border-radius: 12px;
            background: var(--surface-soft);
            border: 1px solid var(--border);
            color: var(--icon);
            text-align: center;
            margin: 20px 30px 30px;
            font-size: 14px;
            font-weight: 500;
        }

        @@media (max-width: 600px) {
            body {
                padding: 16px;
            }

            .header {
                align-items: flex-start;
                flex-direction: column;
                padding: 20px;
            }

            h1 {
                font-size: 20px;
            }

            .summary {
                flex-direction: column;
            }

            .department {
                grid-template-columns: 1fr;
            }

            .department h2 {
                border-right: 0;
                border-bottom: 1px solid var(--divider);
            }

            .connection {
                height: 32px;
                transform: rotate(90deg);
            }
        }
    </style>
</head>
<body>
    <main class="page">
        <header class="header">
            <div>
                <h1>Подписанты по подразделениям</h1>
                <p class="subtitle">Текущие соответствия по активным кадровым записям</p>
            </div>
            <a class="back-link" href="@Url.Action("Index", "Schedule")">К расписанию</a>
        </header>

        @if (Model.Departments.Count == 0)
        {
            <div class="empty">Нет активных кадровых записей для отображения.</div>
        }
        else
        {
            <section class="summary" aria-label="Сводка">
                <div class="summary-item">Подразделений: <strong>@Model.Departments.Count</strong></div>
                <div class="summary-item">Активных записей: <strong>@Model.AssignmentCount</strong></div>
            </section>

            <section class="chart" aria-label="Подписанты по подразделениям">
                @foreach (var department in Model.Departments)
                {
                    <article class="department">
                        <h2>@department.Name</h2>
                        <div class="connection" aria-hidden="true">→</div>
                        <div class="signatory-list">
                            @foreach (var signatory in department.Signatories)
                            {
                                <div class="signatory">
                                    <div class="signatory-name">@signatory.FullName</div>
                                    @if (!string.IsNullOrWhiteSpace(signatory.JobName))
                                    {
                                        <div class="job-name">@signatory.JobName</div>
                                    }
                                </div>
                            }
                        </div>
                    </article>
                }
            </section>
        }
    </main>
</body>
</html>
