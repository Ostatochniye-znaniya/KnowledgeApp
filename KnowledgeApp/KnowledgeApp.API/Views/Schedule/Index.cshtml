@model List<KnowledgeApp.Application.DTOs.TestingScheduleWithFacultyDto>

@{
    Layout = null;
    ViewData["Title"] = "Расписание тестирований";
    
    var scheduleList = Model ?? new List<KnowledgeApp.Application.DTOs.TestingScheduleWithFacultyDto>();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Расписание тестирований</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #ffffff;
            --surface: #ffffff;
            --surface-soft: #EDEDED;
            --surface-alt: #F5F6FE;
            --border: #DBDBDB;
            --divider: #EDEDF9;
            --text: #272727;
            --text-muted: #A3A3A3;
            --icon: #525252;
            --link: #6084E4;
            --link-hover: #5B73BF;
            --primary: #5F6DEC;
            --primary-dark: #4B5EDB;
            --primary-hover: #3242CD;
            --orange: rgba(238, 158, 68, 0.85);
            --orange-text: #815B32;
            --orange-hover: #B47337;
            --blue: rgba(95, 109, 236, 0.9);
            --blue-text: #3D4B95;
            --grey: #525252;
            --danger: rgba(236, 95, 107, 0.9);
            --danger-text: #BF454B;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #D3D8FA 0%, #F9F9F9 100%);
            color: var(--text);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 12px 30px rgba(95, 109, 236, 0.08);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #5F6DEC 0%, #4B5EDB 100%);
            color: #ffffff;
            padding: 20px 30px;
            text-align: center;
            position: relative;
        }

        .header h1 {
            font-size: 20px;
            margin-bottom: 6px;
            color: #ffffff;
            font-weight: 800;
        }

        .header p {
            font-size: 14px;
            opacity: 0.9;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 500;
        }

        .header-actions {
            position: absolute;
            top: 50%;
            left: 30px;
            right: 30px;
            transform: translateY(-50%);
            display: flex;
            justify-content: space-between;
            align-items: center;
            pointer-events: none;
        }

        .btn-pdf {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.7);
            color: white;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'Montserrat', 'Segoe UI', sans-serif;
            pointer-events: auto;
        }

        .btn-pdf:hover {
            background: white;
            color: var(--primary);
        }

        .btn-signatories {
            padding: 8px 14px;
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 8px;
            background: rgba(255,255,255,0.08);
            color: white;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
            font-family: 'Montserrat', 'Segoe UI', sans-serif;
            pointer-events: auto;
        }

        .btn-signatories:hover {
            background: white;
            color: var(--primary);
        }

        .content {
            padding: 20px;
            overflow-x: auto;
        }

        .filter-section {
            background: var(--surface-soft);
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
            justify-content: space-between;
            border: 1px solid var(--border);
        }

        .filter-left {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .filter-section label {
            font-weight: 600;
            color: var(--text);
            font-size: 14px;
        }

        .filter-section select {
            padding: 8px 15px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 14px;
            cursor: pointer;
            background: #EDEDED;
            min-width: 200px;
            color: var(--text);
            font-family: 'Montserrat', 'Segoe UI', sans-serif;
            font-weight: 500;
        }

        .filter-section button {
            background: var(--primary);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
            font-family: 'Montserrat', 'Segoe UI', sans-serif;
        }

        .filter-section button:hover {
            background: var(--primary-hover);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            background: white;
        }

        th {
            background: var(--primary);
            color: white;
            padding: 12px;
            text-align: left;
            font-weight: 600;
            position: sticky;
            top: 0;
        }

        td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--divider);
            color: var(--text);
        }

        td.number-cell {
            width: 56px;
            text-align: center;
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }

        tr:hover {
            background: #f5f6ff;
        }

        .faculty-header {
            background: #f0f1fb;
            font-weight: 700;
        }

        .faculty-header td {
            background: #f0f1fb;
            padding: 12px 15px;
            border-top: 2px solid var(--primary);
            border-bottom: 2px solid var(--primary);
            font-size: 16px;
            color: var(--text);
        }

        .stats {
            background: var(--surface-soft);
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            border: 1px solid var(--border);
        }

        .stats-left {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            align-items: center;
        }

        .stat-card {
            background: white;
            padding: 10px 20px;
            min-height: 44px;
            border-radius: 8px;
            border: 1px solid var(--border);
            box-shadow: 0 2px 8px rgba(39, 39, 39, 0.04);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            line-height: 1.4;
        }

        .stat-card .stat-value {
            font-size: 20px;
            font-weight: 700;
            color: var(--primary);
            line-height: 1;
        }

        .btn-pdf-small {
            background: var(--primary);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-pdf-small:hover {
            background: var(--primary-hover);
            transform: scale(1.02);
        }

        .empty {
            text-align: center;
            padding: 50px;
            color: var(--text-muted);
            font-size: 18px;
        }

        .footer {
            background: #f9f9fb;
            padding: 15px;
            text-align: center;
            color: var(--text-muted);
            font-size: 12px;
            border-top: 1px solid var(--divider);
        }

        .loading {
            text-align: center;
            padding: 50px;
            font-size: 18px;
            color: var(--text-muted);
        }

        .error {
            text-align: center;
            padding: 50px;
            color: var(--danger-text);
            font-size: 18px;
        }

        @@media (max-width: 900px) {
            table {
                font-size: 12px;
            }
            th, td {
                padding: 8px;
            }
            .header h1 {
                font-size: 20px;
            }
            .header {
                padding: 20px;
            }
            .header-actions {
                position: static;
                transform: none;
                justify-content: center;
                flex-wrap: wrap;
                gap: 10px;
                margin-top: 14px;
            }
            .stats {
                flex-direction: column;
                text-align: center;
            }
            .filter-section {
                flex-direction: column;
                align-items: stretch;
            }
            .filter-left {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Расписание тестирований</h1>
            <p>Актуальные данные на текущий момент</p>
            <div class="header-actions">
                <a class="btn-signatories" href="@Url.Action("ByDepartment", "Signatories")">
                    Подписанты по подразделениям
                </a>
                <button class="btn-pdf" onclick="downloadPDF()">
                    Скачать в PDF
                </button>
            </div>
        </div>
        <div class="content">
            <div class="filter-section">
                <div class="filter-left">
                    <label>Факультет:</label>
                    <select id="facultySelect">
                        <option value="0">Все факультеты</option>
                    </select>
                    
                    <label>Семестр:</label>
                    <select id="semesterSelect">
                        <option value="0">Все семестры</option>
                    </select>
                    
                    <button onclick="applyFilter()">Применить фильтр</button>
                    <button onclick="setCurrentSemester()" style="background: rgba(95, 109, 236, 0.9); color: #fff;">Текущий семестр</button>
                    <button onclick="setPreviousSemester()" style="background: rgba(238, 158, 68, 0.85); color: #fff;">Прошлый семестр</button>
                    <button onclick="resetFilter()" style="background: #525252; color: #fff;">Сбросить</button>
                </div>
                <div>
                    <span id="filterInfo" style="color: #525252; font-size: 14px;"></span>
                </div>
            </div>

            <div id="loading" class="loading">
                Загрузка данных...
            </div>
            <div id="error" class="error" style="display: none;">
                Ошибка загрузки данных
            </div>
            <div id="tableContainer" style="display: none;">
                <div id="statsContainer"></div>
                <div style="overflow-x: auto;">
                    <table id="testingTable">
                        <thead>
                            <tr>
                                <th>№</th>
                                <th>Группа</th>
                                <th>Профиль подготовки</th>
                                <th>Дисциплина</th>
                                <th>Кафедра</th>
                                <th>Преподаватель</th>
                                <th>Дата проведения</th>
                                <th>Время проведения</th>
                            </tr>
                        </thead>
                        <tbody id="scheduleBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="footer">
            Система управления тестированием | Данные из базы знаний
        </div>
    </div>

    <script>
        let allData = [];
        let facultiesList = [];
        let semestersList = [];

        async function loadSchedule() {
            const loading = document.getElementById('loading');
            const error = document.getElementById('error');
            const tableContainer = document.getElementById('tableContainer');
            
            loading.style.display = 'block';
            error.style.display = 'none';
            tableContainer.style.display = 'none';
            
            try {
                const [dataResponse, facultiesResponse, semestersResponse] = await Promise.all([
                    fetch('/Schedule/GetTestingScheduleWithFaculty'),
                    fetch('/Schedule/GetFaculties'),
                    fetch('/Schedule/GetSemesters')
                ]);
                
                if (!dataResponse.ok) throw new Error('Ошибка загрузки данных');
                if (!facultiesResponse.ok) throw new Error('Ошибка загрузки факультетов');
                if (!semestersResponse.ok) throw new Error('Ошибка загрузки семестров');
                
                allData = await dataResponse.json();
                facultiesList = await facultiesResponse.json();
                semestersList = await semestersResponse.json();
                
                const facultySelect = document.getElementById('facultySelect');
                facultySelect.innerHTML = '<option value="0">Все факультеты</option>';
                facultiesList.forEach(f => {
                    facultySelect.innerHTML += `<option value="${f.id}">${f.name}</option>`;
                });
                
                const semesterSelect = document.getElementById('semesterSelect');
                semesterSelect.innerHTML = '<option value="0">Все семестры</option>';
                semestersList.forEach(s => {
                    semesterSelect.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                });
                
                if (!allData || allData.length === 0) {
                    showEmptyState();
                    return;
                }
                
                const savedFaculty = localStorage.getItem('selectedFacultyId');
                const savedSemester = localStorage.getItem('selectedSemesterId');
                if (savedFaculty && savedFaculty !== '0') facultySelect.value = savedFaculty;
                if (savedSemester && savedSemester !== '0') semesterSelect.value = savedSemester;
                
                applyFilter();
                
            } catch (err) {
                console.error('Error:', err);
                loading.style.display = 'none';
                error.style.display = 'block';
                error.textContent = `Ошибка загрузки данных: ${err.message}`;
            }
        }

        function applyFilter() {
            const selectedFacultyId = parseInt(document.getElementById('facultySelect').value);
            const selectedSemesterId = parseInt(document.getElementById('semesterSelect').value);
            
            localStorage.setItem('selectedFacultyId', selectedFacultyId);
            localStorage.setItem('selectedSemesterId', selectedSemesterId);
            
            let filteredData = [...allData];
            let facultyName = 'Все факультеты';
            let semesterName = 'Все семестры';
            
            if (selectedFacultyId !== 0) {
                const faculty = facultiesList.find(f => f.id === selectedFacultyId);
                if (faculty) {
                    facultyName = faculty.name;
                    filteredData = filteredData.filter(item => item.facultyId === selectedFacultyId);
                }
            }
            
            if (selectedSemesterId !== 0) {
                const semester = semestersList.find(s => s.id === selectedSemesterId);
                if (semester) {
                    semesterName = semester.name;
                    filteredData = filteredData.filter(item => {
                        const itemDate = new Date(item.date);
                        let startDate, endDate;
                        
                        if (semester.part === 1) {
                            startDate = new Date(semester.year, 1, 1);
                            endDate = new Date(semester.year, 5, 30);
                        } else {
                            startDate = new Date(semester.year, 8, 1);
                            endDate = new Date(semester.year, 11, 31);
                        }
                        
                        return itemDate >= startDate && itemDate <= endDate;
                    });
                }
            }
            
            renderTable(filteredData, facultyName, semesterName, selectedFacultyId, selectedSemesterId);
            
            const filterInfo = document.getElementById('filterInfo');
            filterInfo.textContent = `Показано: ${filteredData.length} из ${allData.length} записей`;
        }

        function resetFilter() {
            document.getElementById('facultySelect').value = '0';
            document.getElementById('semesterSelect').value = '0';
            localStorage.removeItem('selectedFacultyId');
            localStorage.removeItem('selectedSemesterId');
            applyFilter();
        }

        async function setCurrentSemester() {
            try {
                const response = await fetch('/Schedule/GetCurrentSemester');
                if (!response.ok) throw new Error('Ошибка загрузки текущего семестра');
                
                const currentSemester = await response.json();
                
                const semesterSelect = document.getElementById('semesterSelect');
                semesterSelect.value = currentSemester.id.toString();
                
                localStorage.setItem('selectedSemesterId', currentSemester.id);
                applyFilter();
                
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Не удалось определить текущий семестр');
            }
        }

        async function setPreviousSemester() {
            try {
                const currentResponse = await fetch('/Schedule/GetCurrentSemester');
                if (!currentResponse.ok) throw new Error('Ошибка загрузки текущего семестра');
                const referenceSemester = await currentResponse.json();

                if (!referenceSemester) {
                    alert('В базе данных нет доступных семестров');
                    return;
                }

                const semesterSelect = document.getElementById('semesterSelect');
                const orderedSemesters = [...semestersList].sort((a, b) =>
                    a.year - b.year || a.part - b.part);
                const currentIndex = orderedSemesters.findIndex(s => s.id === referenceSemester.id);
                const previousSemester = currentIndex > 0 ? orderedSemesters[currentIndex - 1] : null;

                if (previousSemester) {
                    semesterSelect.value = previousSemester.id.toString();
                    localStorage.setItem('selectedSemesterId', previousSemester.id);
                    applyFilter();
                } else {
                    alert('Предыдущий семестр не найден в базе данных');
                }
                
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Не удалось определить прошлый семестр');
            }
        }

                    function renderTable(data, facultyName, semesterName, facultyId, semesterId) {
                const loading = document.getElementById('loading');
                const tableContainer = document.getElementById('tableContainer');
                const statsContainer = document.getElementById('statsContainer');
                const scheduleBody = document.getElementById('scheduleBody');

                if (!data || data.length === 0) {
                    showEmptyState();
                    return;
                }

                scheduleBody.innerHTML = '';

                let currentFaculty = '';
                let currentGroup = '';
                let groupStartIndex = -1;
                let rows = [];

                // Сначала собираем все строки
                data.forEach((item, idx) => {
                    if (currentFaculty !== item.facultyName) {
                        currentFaculty = item.facultyName;
                        const facultyRow = { isFaculty: true, facultyName: item.facultyName };
                        rows.push(facultyRow);
                    }

                    rows.push({ isData: true, item: item, index: idx });
                });

                // Отрисовываем таблицу
                let i = 0;

                while (i < rows.length) {
                    if (rows[i].isFaculty) {
                        const facultyRow = scheduleBody.insertRow();
                        facultyRow.className = 'faculty-header';
                        const cell = facultyRow.insertCell(0);
                        cell.colSpan = 8;
                        cell.textContent = rows[i].facultyName;
                        cell.style.fontWeight = 'bold';
                        cell.style.fontSize = '16px';
                        cell.style.backgroundColor = '#e8e8e8';
                        cell.style.padding = '12px 15px';
                        i++;
                        continue;
                    }

                    // Находим группу одинаковых строк
                    const currentItem = rows[i].item;
                    const currentGroupName = currentItem.groupName;
                    let j = i;
                    let groupItems = [];

                    while (j < rows.length && !rows[j].isFaculty && rows[j].item.groupName === currentGroupName) {
                        groupItems.push(rows[j].item);
                        j++;
                    }

                    const groupSize = groupItems.length;

                    // Отрисовываем строки группы
                    for (let k = 0; k < groupSize; k++) {
                        const item = groupItems[k];
                        const row = scheduleBody.insertRow();

                        // Показываем идентификатор записи без дублирующего порядкового номера.
                        const numberCell = row.insertCell(0);
                        numberCell.className = 'number-cell';
                        numberCell.textContent = item.id;

                        // Группа (объединяем для всех строк группы)
                        if (k === 0) {
                            const groupCell = row.insertCell(1);
                            groupCell.textContent = item.groupName || '-';
                            groupCell.rowSpan = groupSize;
                            groupCell.style.verticalAlign = 'middle';
                            groupCell.style.backgroundColor = '#f9f9f9';
                        }

                        // Профиль подготовки (объединяем для всех строк группы)
                        if (k === 0) {
                            const programCell = row.insertCell(2);
                            programCell.textContent = item.programName || '-';
                            programCell.rowSpan = groupSize;
                            programCell.style.verticalAlign = 'middle';
                            programCell.style.backgroundColor = '#f9f9f9';
                        }

                        // Остальные ячейки (без объединения)
                        if (k > 0) {
                            // Пропускаем ячейки группы и профиля, так как они уже добавлены с rowSpan
                            row.insertCell(1); // пустая, будет скрыта
                            row.insertCell(2); // пустая, будет скрыта
                        }

                        row.insertCell(k > 0 ? 3 : 3).textContent = item.disciplineName || '-';
                        row.insertCell(k > 0 ? 4 : 4).textContent = item.departmentName || '-';
                        row.insertCell(k > 0 ? 5 : 5).textContent = item.teacherName || '-';

                        const date = new Date(item.date);
                        const formattedDate = date.toLocaleDateString('ru-RU', {
                            day: '2-digit',
                            month: '2-digit',
                            year: 'numeric'
                        });
                        row.insertCell(k > 0 ? 6 : 6).textContent = formattedDate;
                        row.insertCell(k > 0 ? 7 : 7).textContent = item.time || '-';

                        // Скрываем лишние ячейки, если они были добавлены
                        if (k > 0) {
                            const cells = row.cells;
                            // Удаляем пустые ячейки, которые мы добавили для группы и профиля
                            if (cells[1] && cells[1].textContent === '') cells[1].style.display = 'none';
                            if (cells[2] && cells[2].textContent === '') cells[2].style.display = 'none';
                        }
                    }

                    i = j;
                }

                const displayFaculty = facultyId === 0 ? 'Все факультеты' : facultyName;
                const displaySemester = semesterId === 0 ? 'Все семестры' : semesterName;

                statsContainer.innerHTML = `
                    <div class="stats">
                        <div class="stats-left">
                            <div class="stat-card">${displayFaculty}</div>
                            <div class="stat-card">${displaySemester}</div>
                            <div class="stat-card">
                                <span>Всего тестирований:</span>
                                <span class="stat-value">${data.length}</span>
                            </div>
                        </div>
                        <button class="btn-pdf-small" onclick="downloadPDF()">Скачать PDF</button>
                    </div>
                `;

                loading.style.display = 'none';
                tableContainer.style.display = 'block';
            }

        function showEmptyState() {
            const loading = document.getElementById('loading');
            const tableContainer = document.getElementById('tableContainer');
            const statsContainer = document.getElementById('statsContainer');
            const scheduleBody = document.getElementById('scheduleBody');
            
            scheduleBody.innerHTML = '<tr><td colspan="8" style="text-align: center;">Нет запланированных тестирований</td></tr>';
            statsContainer.innerHTML = '';
            loading.style.display = 'none';
            tableContainer.style.display = 'block';
        }

        async function downloadPDF() {
            const selectedFacultyId = parseInt(document.getElementById('facultySelect').value);
            const selectedSemesterId = parseInt(document.getElementById('semesterSelect').value);
            
            try {
                const buttons = document.querySelectorAll('.btn-pdf, .btn-pdf-small');
                buttons.forEach(btn => {
                    btn.disabled = true;
                    btn.textContent = 'Генерация PDF...';
                });
                
                let url = `/Schedule/DownloadPdfByFaculty?facultyId=${selectedFacultyId}&semesterId=${selectedSemesterId}`;
                
                const response = await fetch(url);
                
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || 'Ошибка при генерации PDF');
                }
                
                const blob = await response.blob();
                const urlBlob = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = urlBlob;
                
                const now = new Date();
                const filename = `Расписание_тестирований_${now.getFullYear()}-${now.getMonth()+1}-${now.getDate()}.pdf`;
                
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(urlBlob);
                
                alert('PDF успешно сгенерирован и скачан!');
                
            } catch (error) {
                console.error('Ошибка:', error);
                alert(`Ошибка при скачивании PDF: ${error.message}`);
            } finally {
                const buttons = document.querySelectorAll('.btn-pdf, .btn-pdf-small');
                buttons.forEach(btn => {
                    btn.disabled = false;
                    btn.textContent = btn.classList.contains('btn-pdf-small') ? 'Скачать PDF' : 'Скачать в PDF';
                });
            }
        }
        
        loadSchedule();
    </script>
</body>
</html>