@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var profileName = ViewData["ProfileName"]?.ToString() ?? "Пользователь";
}
<!DOCTYPE html>
<html lang="ru" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] — Проверка остаточных знаний</title>
    <style>
        :root {
            color-scheme: light;
            --page: #f9f9f9;
            --surface: #f9f9f9;
            --surface-muted: #ededed;
            --text: #272727;
            --muted: #525252;
            --border: #dbdbdb;
            --accent: #6d86e4;
            --accent-soft: #ededf9;
            --success: #106c3e;
            --success-soft: #e4f4e9;
            --warning: #a15c16;
            --warning-soft: #fff0dc;
            --danger: #b5485a;
            --danger-soft: #fbe8ed;
            --brand-dot: #272727;
            --shadow: 0 14px 28px #27272735;
        }
        [data-theme="dark"] {
            color-scheme: dark;
            --page: #3a3a3a;
            --surface: #2e2e2e;
            --surface-muted: #363636;
            --text: #f0f0f0;
            --muted: #c9c9c9;
            --border: #434343;
            --accent: #a8b5ff;
            --accent-soft: #333339;
            --success: #a1e8cc;
            --success-soft: #315b49;
            --warning: #ffcc9c;
            --warning-soft: #624a32;
            --danger: #f2a7bd;
            --danger-soft: #583943;
            --brand-dot: #d6d6d6;
            --shadow: 0 14px 28px #0006;
        }
        * { box-sizing: border-box; }
        [hidden] { display: none !important; }
        body {
            margin: 0;
            background: var(--page);
            color: var(--text);
            font: 15px/1.5 "Montserrat", "Century Gothic", "Segoe UI", Arial, sans-serif;
            transition: background .2s ease, color .2s ease;
        }
        .app-shell { min-height: 100vh; display: grid; grid-template-columns: clamp(280px, 19vw, 370px) minmax(0, 1fr); }
        .sidebar {
            position: sticky; top: 0; height: 100vh; padding: 28px clamp(24px, 3vw, 60px);
            background: var(--surface); box-shadow: 8px 0 22px #0002;
            display: flex; flex-direction: column; gap: 28px; z-index: 1;
        }
        .brand { display: grid; gap: 12px; color: var(--text); text-decoration: none; }
        .brand-main { display: flex; gap: 16px; align-items: center; }
        .brand-mark {
            position: relative; width: 66px; height: 66px; border-radius: 50%; flex: 0 0 auto;
            background: conic-gradient(from 25deg, #292929, #8c8c8c 32%, #ededed 65%, #404040);
        }
        .brand-mark::before {
            content: ""; position: absolute; inset: 17px; border-radius: 50%; background: var(--surface);
        }
        .brand-mark::after {
            content: ""; position: absolute; top: 20px; right: 1px; width: 18px; height: 18px;
            border-radius: 50%; background: var(--brand-dot);
        }
        .brand strong { display: block; font-size: clamp(16px, 1vw, 20px); line-height: 1.15; letter-spacing: .08em; text-transform: uppercase; }
        .brand small { display: block; padding: 10px 8px 0; border-top: 1px solid var(--muted); color: var(--accent); font-size: 17px; line-height: 1.2; }
        .profile { padding: 12px 0; text-align: center; }
        .avatar {
            width: clamp(64px, 5.2vw, 100px); height: clamp(64px, 5.2vw, 100px); margin: 10px auto 12px; border-radius: 50%;
            background: var(--surface-muted); color: var(--accent); display: grid; place-items: center;
            font-size: 26px; font-weight: 700;
        }
        .profile-name { overflow-wrap: anywhere; font-size: clamp(16px, 1.1vw, 21px); font-weight: 700; line-height: 1.25; }
        .profile-role { margin-top: 3px; color: var(--muted); font-size: clamp(12px, .7vw, 14px); }
        .side-nav { display: grid; gap: 12px; margin-top: 12px; }
        .side-nav a, .theme-toggle {
            display: flex; align-items: center; gap: 16px; width: 100%; padding: 8px 4px;
            color: var(--text); background: transparent; border: 0; border-radius: 8px;
            text-align: left; text-decoration: none; font: inherit; font-size: clamp(16px, 1.2vw, 23px); cursor: pointer;
        }
        .side-nav a:hover, .theme-toggle:hover { color: var(--accent); }
        .side-nav a.active { color: var(--accent); font-weight: 700; }
        .nav-dot { width: 14px; height: 14px; border-radius: 50%; background: currentColor; flex: 0 0 auto; }
        .sidebar-bottom { margin-top: auto; }
        .theme-toggle { justify-content: flex-start; }
        .mobile-theme-toggle { display: none !important; }
        .main-area {
            min-width: 0; padding: clamp(24px, 3vw, 60px);
            background: linear-gradient(145deg, #596be6 0%, #9b9de8 52%, #414141 100%) fixed;
        }
        [data-theme="dark"] .main-area {
            background: linear-gradient(145deg, #41478d 0%, #373768 46%, #333 100%) fixed;
        }
        .page-content {
            width: min(1480px, 100%); min-height: calc(100vh - clamp(48px, 6vw, 120px));
            margin: 0 auto; padding: clamp(28px, 3.2vw, 64px);
            background: var(--surface); border-radius: 30px; box-shadow: var(--shadow);
        }
        .page-heading { display: flex; gap: 20px; align-items: flex-start; justify-content: space-between; margin-bottom: 28px; }
        .page-heading h1 { margin: 0; font-size: clamp(28px, 2vw, 40px); line-height: 1.2; letter-spacing: -.025em; }
        .page-heading p { max-width: 720px; margin: 10px 0 0; color: var(--muted); font-size: 14px; }
        .surface-card { background: transparent; border: 0; border-radius: 0; box-shadow: none; }
        .toolbar { display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 8px 0 22px; border-bottom: 1px solid var(--border); }
        .toolbar-left, .toolbar-right { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        .search {
            width: 348px; max-width: 100%; min-width: 0; height: 45px; padding: 0 13px; border: 1px solid var(--border);
            border-radius: 8px; background: var(--surface); color: var(--text); font: inherit; font-size: 13px;
        }
        .select {
            min-width: 145px; height: 45px; padding: 0 13px; border: 1px solid var(--border);
            border-radius: 8px; background: var(--surface); color: var(--text); font: inherit; font-size: 13px;
        }
        .button {
            display: inline-flex; justify-content: center; align-items: center; gap: 8px;
            min-width: 140px; min-height: 44px; padding: 10px 16px; border: 1px solid var(--border); border-radius: 7px;
            background: var(--surface); color: var(--text); text-decoration: none; font: inherit;
            font-size: clamp(13px, .8vw, 16px); font-weight: 700; text-align: center; cursor: pointer; transition: transform .15s ease, opacity .15s ease;
        }
        .button:hover:not(:disabled) { transform: translateY(-1px); }
        .button-primary { border-color: var(--accent); background: var(--accent); color: #fff; }
        .button-subtle { background: var(--accent-soft); border-color: transparent; color: var(--accent); }
        .button-danger { background: var(--danger-soft); border-color: transparent; color: var(--danger); }
        .button:disabled { opacity: .5; cursor: not-allowed; }
        .table-scroll { width: 100%; max-width: 1245px; margin: 0 auto; overflow-x: auto; border: 1px solid var(--border); border-radius: 8px; }
        .app-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: clamp(12px, .75vw, 14px); table-layout: fixed; }
        .app-table th { padding: 15px 12px; background: var(--surface-muted); color: var(--text); font-size: clamp(12px, .7vw, 14px); font-weight: 700; line-height: 1.25; text-align: center; white-space: normal; }
        .app-table td { padding: 17px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; line-height: 1.4; }
        .app-table th + th, .app-table td + td { border-left: 1px solid var(--border); }
        .app-table tbody tr:last-child td { border-bottom: 0; }
        .app-table tbody tr:nth-child(odd) { background: var(--accent-soft); }
        .app-table tbody tr:hover { background: color-mix(in srgb, var(--accent) 16%, var(--surface)); }
        .approval-table th:nth-child(-n+4), .approval-table td:nth-child(-n+4),
        .teacher-report-table th:first-child, .teacher-report-table td:first-child,
        .teacher-report-table th:nth-child(5), .teacher-report-table td:nth-child(5),
        .dean-report-table th:nth-child(-n+3), .dean-report-table td:nth-child(-n+3) { text-align: left; }
        .approval-table { min-width: 1245px; }
        .approval-table th:nth-child(1), .approval-table td:nth-child(1) { width: 10%; }
        .approval-table th:nth-child(2), .approval-table td:nth-child(2) { width: 17%; }
        .approval-table th:nth-child(3), .approval-table td:nth-child(3) { width: 15%; }
        .approval-table th:nth-child(4), .approval-table td:nth-child(4) { width: 10%; }
        .approval-table th:nth-child(5), .approval-table td:nth-child(5) { width: 18%; }
        .approval-table th:nth-child(6), .approval-table td:nth-child(6) { width: 13%; }
        .approval-table th:nth-child(7), .approval-table td:nth-child(7) { width: 17%; }
        .teacher-report-table { min-width: 1245px; }
        .teacher-report-table th:nth-child(1), .teacher-report-table td:nth-child(1) { width: 20%; }
        .teacher-report-table th:nth-child(2), .teacher-report-table td:nth-child(2) { width: 15%; }
        .teacher-report-table th:nth-child(3), .teacher-report-table td:nth-child(3) { width: 12%; }
        .teacher-report-table th:nth-child(4), .teacher-report-table td:nth-child(4) { width: 21%; }
        .teacher-report-table th:nth-child(5), .teacher-report-table td:nth-child(5) { width: 17%; }
        .teacher-report-table th:nth-child(6), .teacher-report-table td:nth-child(6) { width: 15%; }
        .dean-report-table { min-width: 1245px; }
        .dean-report-table th:nth-child(1), .dean-report-table td:nth-child(1) { width: 14%; }
        .dean-report-table th:nth-child(2), .dean-report-table td:nth-child(2) { width: 17%; }
        .dean-report-table th:nth-child(3), .dean-report-table td:nth-child(3) { width: 17%; }
        .dean-report-table th:nth-child(4), .dean-report-table td:nth-child(4) { width: 17%; }
        .dean-report-table th:nth-child(5), .dean-report-table td:nth-child(5) { width: 15%; }
        .dean-report-table th:nth-child(6), .dean-report-table td:nth-child(6) { width: 20%; }
        .table-status, .table-actions { text-align: center; }
        .table-status .badge { display: flex; width: 100%; min-width: 0; max-width: 100%; min-height: 36px; margin: 0 auto 7px; align-items: center; justify-content: center; white-space: normal; overflow-wrap: anywhere; }
        .primary-text { font-weight: 700; }
        .secondary-text { margin-top: 4px; color: var(--muted); font-size: 12px; }
        .badge {
            display: inline-flex; padding: 7px 11px; border-radius: 6px; background: var(--surface-muted);
            color: var(--muted);             font-size: clamp(11px, .7vw, 13px); font-weight: 700; line-height: 1.25; white-space: nowrap;
        }
        .badge-success { background: var(--success-soft); color: var(--success); }
        .badge-warning { background: var(--warning-soft); color: var(--warning); }
        .badge-danger { background: var(--danger-soft); color: var(--danger); }
        .badge-accent { background: var(--accent-soft); color: var(--accent); }
        .notice { margin: 0; padding: 14px 16px; color: var(--muted); font-size: 12px; }
        .notice.error { color: var(--danger); background: var(--danger-soft); }
        .notice.success { color: var(--success); background: var(--success-soft); }
        .empty-state { padding: 52px 20px; color: var(--muted); text-align: center; }
        .empty-state strong { display: block; margin-bottom: 5px; color: var(--text); font-size: 14px; }
        .row-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; justify-content: center; }
        .row-actions .button { width: 100%; max-width: 190px; min-width: 150px; min-height: 48px; white-space: normal; }
        .delivery-toggle { display: inline-flex; gap: 8px; align-items: center; font-weight: 700; white-space: nowrap; }
        .delivery-toggle input { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
        .delivery-field-label { display: block; margin: 0 0 6px; font-size: 12px; font-weight: 700; }
        .modal input[type="text"], .modal input[type="url"] { width: 100%; height: 44px; padding: 0 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); font: inherit; }
        .modal .secondary-text { margin-top: 6px; }
        .room-editor, .lms-editor { display: flex; gap: 6px; align-items: center; }
        .lms-editor .button { width: auto; min-width: 66px; min-height: 36px; padding: 6px 10px; font-size: 12px; }
        .room-value { min-width: 0; overflow-wrap: anywhere; font-weight: 700; }
        .room-input, .lms-input { width: 100%; min-width: 0; height: 38px; padding: 0 9px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); color: var(--text); font: inherit; font-size: 12px; }
        .icon-button { display: inline-grid; place-items: center; flex: 0 0 36px; width: 36px; height: 36px; padding: 0; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); color: var(--accent); cursor: pointer; }
        .icon-button:hover { background: var(--accent-soft); }
        .icon-button:disabled { opacity: .5; cursor: not-allowed; }
        .lms-link { color: var(--accent); font-weight: 700; text-decoration: underline; overflow-wrap: anywhere; }
        .template-download { gap: 8px; max-width: 220px; min-width: 180px; min-height: 44px; }
        .feedback { margin: 0 16px 16px; }
        .report-upload-form { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-width: 0; gap: 8px; justify-items: stretch; }
        .report-upload-form .button { width: 100%; min-width: 0; max-width: none; min-height: 40px; padding: 8px 10px; font-size: 12px; }
        .file-input-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
        .file-input-hidden:focus-visible + .file-select-button { outline: 2px solid var(--accent); outline-offset: 2px; }
        .file-name { display: block; width: 100%; min-width: 0; max-width: 100%; overflow: hidden; color: var(--muted); font-size: 11px; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
        .report-upload-form .button:disabled { transform: none; }
        .modal-backdrop { position: fixed; inset: 0; z-index: 5; display: grid; place-items: center; padding: 20px; background: #0008; }
        .modal { width: min(520px, 100%); padding: 22px; border-radius: 14px; background: var(--surface); box-shadow: var(--shadow); }
        .modal h2 { margin: 0 0 7px; font-size: 18px; }
        .modal p { margin: 0 0 15px; color: var(--muted); font-size: 12px; }
        .modal textarea { width: 100%; min-height: 130px; padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); font: inherit; resize: vertical; }
        .modal input[type="url"] { width: 100%; height: 44px; padding: 0 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); font: inherit; }
        .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 14px; }
        .file-picker { max-width: 225px; color: var(--muted); font: inherit; font-size: 11px; }
        .file-picker::file-selector-button { margin-right: 8px; padding: 7px 10px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface-muted); color: var(--text); cursor: pointer; }
        .footer-note { margin: 16px 0 0; color: var(--muted); font-size: 12px; }
        @@media (max-width: 800px) {
            .app-shell { grid-template-columns: 1fr; }
            .sidebar { position: static; width: 100%; height: auto; padding: 12px 15px; gap: 10px; box-shadow: none; border-bottom: 1px solid var(--border); }
            .brand { display: flex; align-items: center; gap: 12px; }
            .brand-main { gap: 10px; }
            .brand-mark { width: 34px; height: 34px; }
            .brand-mark::before { inset: 9px; }
            .brand-mark::after { top: 9px; width: 10px; height: 10px; }
            .brand small { padding: 0; border: 0; margin: 0; font-size: 11px; }
            .brand strong { font-size: 12px; }
            .profile { display: none; }
            .side-nav { display: flex; overflow-x: auto; gap: 5px; margin-top: 0; }
            .side-nav a { width: auto; gap: 8px; padding: 9px 10px; font-size: 13px; white-space: nowrap; }
            .nav-dot { width: 8px; height: 8px; }
            .sidebar-bottom { display: none; }
            .mobile-theme-toggle { display: flex !important; width: auto; font-size: 13px; white-space: nowrap; }
            .main-area { padding: 24px 14px 36px; }
            .page-content { min-height: 0; padding: 26px 22px; border-radius: 20px; }
        }
        @@media (max-width: 560px) {
            .page-heading { display: block; margin-bottom: 18px; }
            .toolbar { align-items: stretch; }
            .toolbar-left, .toolbar-right { width: 100%; }
            .search { width: 100%; min-width: 0; }
            .select { flex: 1; }
            .file-picker { max-width: 180px; }
            .page-content { padding: 22px 16px; }
            .button { min-width: 125px; }
        }
    </style>
    @await RenderSectionAsync("PageStyles", required: false)
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="@Url.Action("Index", "Schedule")">
                <span class="brand-main">
                    <span class="brand-mark" aria-hidden="true"></span>
                    <strong>Московский<br>политех</strong>
                </span>
                <small>Проверка остаточных знаний</small>
            </a>
            <div class="profile">
                <div class="avatar" aria-hidden="true"></div>
                <div class="profile-name">@profileName</div>
                <div class="profile-role">Личный кабинет</div>
            </div>
            <nav class="side-nav" aria-label="Основная навигация">
                @if (controller == "Dean")
                {
                    <a href="@Url.Action("Reports", "Teacher")">
                        <span class="nav-dot" aria-hidden="true"></span>Мои отчёты
                    </a>
                    <a class="active" href="@Url.Action("Reports", "Dean")">
                        <span class="nav-dot" aria-hidden="true"></span>Проверка отчётов
                    </a>
                }
                else
                {
                    <a class="@(action == "Approvals" ? "active" : "")" href="@Url.Action("Approvals", "Teacher")">
                        <span class="nav-dot" aria-hidden="true"></span>Согласование тестирований
                    </a>
                    <a class="@(action == "Reports" ? "active" : "")" href="@Url.Action("Reports", "Teacher")">
                        <span class="nav-dot" aria-hidden="true"></span>Мои отчёты
                    </a>
                }
                <button class="theme-toggle mobile-theme-toggle" id="mobile-theme-toggle" type="button" aria-label="Сменить тему">
                    <span aria-hidden="true">◐</span>Тема
                </button>
            </nav>
            <div class="sidebar-bottom">
                <button class="theme-toggle" id="theme-toggle" type="button"><span aria-hidden="true">◐</span>Сменить тему</button>
            </div>
        </aside>
        <main class="main-area">
            <div class="page-content">@RenderBody()</div>
        </main>
    </div>
    <script>
        const savedTheme = localStorage.getItem('knowledge-theme');
        if (savedTheme === 'dark') document.documentElement.dataset.theme = 'dark';
        function toggleTheme() {
            const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            document.documentElement.dataset.theme = nextTheme;
            localStorage.setItem('knowledge-theme', nextTheme);
        }
        document.querySelectorAll('.theme-toggle').forEach(button => button.addEventListener('click', toggleTheme));
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
