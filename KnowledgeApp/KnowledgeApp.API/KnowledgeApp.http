@KnowledgeApp_HostAddress = http://localhost:5134

GET {{KnowledgeApp_HostAddress}}/weatherforecast/
Accept: application/json

###

### Download the prefilled report forms for all disciplines of a group in a semester
GET {{KnowledgeApp_HostAddress}}/csh/api/ReportFile/DownloadGroupTemplate?groupId=1&semesterId=1
Accept: application/pdf

### Set testing delivery mode and classroom (use isInPerson=false and lmsUrl for LMS)
PATCH {{KnowledgeApp_HostAddress}}/csh/api/Testing/UpdateDelivery/1
Content-Type: application/json

{
  "isInPerson": true,
  "room": "Аудитория 101"
}
