@KnowledgeApp_HostAddress = http://localhost:5134

GET {{KnowledgeApp_HostAddress}}/weatherforecast/
Accept: application/json

###

### Сформировать отдельный отчёт по дисциплине и сохранить его в MinIO
GET {{KnowledgeApp_HostAddress}}/csh/api/ReportFile/GenerateGroupReport?groupId=1&semesterId=1&disciplineId=1
Accept: application/pdf

### Скачать ранее сформированный отчёт из MinIO
GET {{KnowledgeApp_HostAddress}}/csh/api/ReportFile/DownloadStoredGroupReport?groupId=1&semesterId=1&disciplineId=1
Accept: application/pdf

### Указать очный формат и аудиторию (для LMS укажите isInPerson=false и lmsUrl)
PATCH {{KnowledgeApp_HostAddress}}/csh/api/Testing/UpdateDelivery/1
Content-Type: application/json

{
  "isInPerson": true,
  "room": "Аудитория 101"
}

### Создать приказ; в ответе вернётся идентификатор сохранённого приказа
POST {{KnowledgeApp_HostAddress}}/csh/api/createOrder
Content-Type: application/json

{
  "orderDate": "2026-10-18",
  "number": "1218-ОД",
  "semesterId": 1,
  "educationControlDepartmentHead": "Иванов Иван Иванович",
  "educationalMethodicalCenterHead": "Петрова Анна Сергеевна",
  "inspectionSummaryDeadline": "2026-12-20",
  "surveySummaryDeadline": "2026-11-15",
  "surveyStartDate": "2026-10-20",
  "surveyEndDate": "2026-11-10",
  "paperReportDeadline": "2026-12-25",
  "electronicReportDeadline": "2026-12-25",
  "testingStartDate": "2026-11-01",
  "testingEndDate": "2026-12-15",
  "preparationStartDate": "2026-10-19",
  "preparationEndDate": "2026-10-31",
  "resultsProcessingStartDate": "2026-12-16"
}

### Получить список созданных приказов
GET {{KnowledgeApp_HostAddress}}/csh/api/getOrdersEssentials
Accept: application/json

### Скачать ранее созданный приказ по его идентификатору
GET {{KnowledgeApp_HostAddress}}/csh/api/getOrder/1
Accept: application/pdf
